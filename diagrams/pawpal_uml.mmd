classDiagram
    class Owner {
        +name
        +update_details()
    }

    class Pet {
        +name
        +species
        +update_details()
    }

    class CareTask {
        +title
        +duration
        +priority
        +due_date
        +is_completed
        +mark_complete()
    }

    class DailyPlan {
        +date
        +tasks
        +add_task(task)
        +show_schedule()
    }

    Owner "1" --> "1..*" Pet : has
    Pet "1" --> "0..*" CareTask : has
    DailyPlan "0..*" --> "0..*" CareTask : schedules
